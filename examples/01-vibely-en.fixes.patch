diff --git a/lib/analytics.ts b/lib/analytics.ts
new file mode 100644
index 0000000..6363a99
--- /dev/null
+++ b/lib/analytics.ts
@@ -0,0 +1,18 @@
+import posthog from "posthog-js";
+
+// PostHog (analytics + session recording) starts only after the visitor clicks Accept.
+// Inputs are masked by PostHog's default settings; do not turn that off.
+let started = false;
+
+export function acceptTracking() {
+  if (started) return;
+  started = true;
+  posthog.init(process.env.NEXT_PUBLIC_POSTHOG_KEY ?? "", {
+    api_host: process.env.NEXT_PUBLIC_POSTHOG_HOST ?? "https://us.i.posthog.com",
+    person_profiles: "identified_only",
+  });
+}
+
+export function declineTracking() {
+  if (started) posthog.opt_out_capturing();
+}
