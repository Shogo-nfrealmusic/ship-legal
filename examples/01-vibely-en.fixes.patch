@@ -0,0 +1,22 @@
+import { NextResponse } from "next/server";
+import Stripe from "stripe";
+import { currentUserId, db } from "@/lib/db";
+
+// POST /api/billing-portal — sends the user to the Stripe Customer Portal to manage or cancel.
+export async function POST() {
+  const stripe = new Stripe(process.env.STRIPE_SECRET_KEY as string);
+  const appUrl = process.env.NEXT_PUBLIC_APP_URL ?? "http://localhost:3000";
+
+  // TODO(legal-check): stripeCustomerId is never saved yet. Save session.customer from the
+  // checkout.session.completed webhook so this route can find it.
+  const user = db.findById(currentUserId());
+  if (!user?.stripeCustomerId) {
+    return NextResponse.json({ error: "No subscription found for this account." }, { status: 404 });
+  }
+
+  const session = await stripe.billingPortal.sessions.create({
+    customer: user.stripeCustomerId,
+    return_url: `${appUrl}/settings/profile`,
+  });
+  return NextResponse.redirect(session.url, 303);
+}
