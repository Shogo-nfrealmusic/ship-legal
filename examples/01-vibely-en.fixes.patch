diff --git a/app/api/unsubscribe/route.ts b/app/api/unsubscribe/route.ts
new file mode 100644
index 0000000..4e7fc5f
--- /dev/null
+++ b/app/api/unsubscribe/route.ts
@@ -0,0 +1,37 @@
+import { db } from "@/lib/db";
+import { verifyUnsubscribeToken } from "@/lib/unsubscribe";
+
+// GET shows a confirm button only (mail scanners open links automatically).
+// POST unsubscribes; it also serves one-click unsubscribe from mail apps (RFC 8058).
+
+function params(req: Request) {
+  const url = new URL(req.url);
+  return { email: url.searchParams.get("email") ?? "", token: url.searchParams.get("token") ?? "" };
+}
+
+function page(body: string, status = 200) {
+  return new Response(
+    `<!doctype html><meta charset="utf-8"><title>Unsubscribe · Vibely</title>` +
+      `<main style="font-family:system-ui,sans-serif;max-width:480px;margin:48px auto;padding:0 20px">${body}</main>`,
+    { status, headers: { "Content-Type": "text/html; charset=utf-8" } },
+  );
+}
+
+const escape = (s: string) =>
+  s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
+
+export async function GET(req: Request) {
+  const { email, token } = params(req);
+  if (!email || !verifyUnsubscribeToken(email, token)) return page("<p>This unsubscribe link is not valid.</p>", 400);
+  return page(
+    `<h1>Unsubscribe</h1><p>Stop marketing emails to <b>${escape(email)}</b>?</p>` +
+      `<form method="post"><button type="submit">Unsubscribe</button></form>`,
+  );
+}
+
+export async function POST(req: Request) {
+  const { email, token } = params(req);
+  if (!email || !verifyUnsubscribeToken(email, token)) return page("<p>This unsubscribe link is not valid.</p>", 400);
+  db.unsubscribe(email);
+  return page("<h1>You're unsubscribed</h1><p>You won't get marketing emails from Vibely anymore.</p>");
+}
