+export const COMPANY_POSTAL_ADDRESS = process.env.COMPANY_POSTAL_ADDRESS ?? "TODO: your postal address";
+
+export function appUrl(): string {
+  const url = process.env.NEXT_PUBLIC_APP_URL;
+  if (url) return url;
+  // A localhost link in a real email would be a dead unsubscribe link.
+  if (process.env.NODE_ENV === "production") throw new Error("NEXT_PUBLIC_APP_URL is not set");
+  return "http://localhost:3000";
+}
