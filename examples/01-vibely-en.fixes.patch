+++ b/lib/analytics.ts
@@ -0,0 +1,18 @@
+import posthog from "posthog-js";
+
+// PostHog is only initialised after the visitor clicks "Accept" in the consent banner.
+// Default input masking stays on (no maskAllInputs: false).
+let started = false;
+
+export function acceptTracking() {
+  if (started) return;
+  started = true;
+  posthog.init(process.env.NEXT_PUBLIC_POSTHOG_KEY ?? "", {
+    api_host: process.env.NEXT_PUBLIC_POSTHOG_HOST ?? "https://us.i.posthog.com",
+    person_profiles: "identified_only",
+  });
+}
+
+export function declineTracking() {
+  if (started) posthog.opt_out_capturing();
+}
