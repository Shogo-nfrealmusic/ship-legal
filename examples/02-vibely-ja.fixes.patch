diff --git a/app/api/unsubscribe/route.ts b/app/api/unsubscribe/route.ts
new file mode 100644
index 0000000..23aa753
--- /dev/null
+++ b/app/api/unsubscribe/route.ts
@@ -0,0 +1,39 @@
+import { NextResponse } from "next/server";
+import { db } from "@/lib/db";
+import { verifyUnsubscribeToken } from "@/lib/unsubscribe";
+
+function params(req: Request) {
+  const url = new URL(req.url);
+  return { email: url.searchParams.get("email") ?? "", token: url.searchParams.get("token") ?? "" };
+}
+
+function page(body: string, status = 200) {
+  return new NextResponse(
+    `<!doctype html><meta name="viewport" content="width=device-width"><body style="font-family:system-ui;max-width:480px;margin:48px auto;padding:0 20px">${body}</body>`,
+    { status, headers: { "Content-Type": "text/html; charset=utf-8" } },
+  );
+}
+
+const escape = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
+
+// GET only shows a confirm button: mail scanners open links and must not unsubscribe people.
+export async function GET(req: Request) {
+  const { email, token } = params(req);
+  if (!email || !token || !verifyUnsubscribeToken(email, token)) {
+    return page("<p>This unsubscribe link is invalid.</p>", 400);
+  }
+  return page(
+    `<h1>Unsubscribe</h1><p>Stop Vibely emails to ${escape(email)}?</p>` +
+      `<form method="post"><button type="submit">Unsubscribe</button></form>`,
+  );
+}
+
+// POST unsubscribes. Also serves one-click unsubscribe from mail apps (RFC 8058).
+export async function POST(req: Request) {
+  const { email, token } = params(req);
+  if (!email || !token || !verifyUnsubscribeToken(email, token)) {
+    return page("<p>This unsubscribe link is invalid.</p>", 400);
+  }
+  db.unsubscribe(email);
+  return page("<p>You're unsubscribed. You won't get these emails anymore.</p>");
+}
