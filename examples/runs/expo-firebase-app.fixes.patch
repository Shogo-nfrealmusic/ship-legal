+// DRAFT generated by /legal-check. Have a lawyer review before relying on it.
+import { ScrollView, Text } from "react-native";
+import { LEGAL, legal } from "@/lib/legal";
+
+const H = ({ children }: { children: string }) => <Text accessibilityRole="header" style={{ fontSize: 18, fontWeight: "700", marginTop: 16 }}>{children}</Text>;
+
+export default function Privacy() {
+  return (
+    <ScrollView contentContainerStyle={{ padding: 24, paddingTop: 60 }}>
+      <Text accessibilityRole="header" style={{ fontSize: 24, fontWeight: "800" }}>Privacy Policy</Text>
+      <Text>Effective {legal(LEGAL.effectiveDate)}. InstaVibe is run by {legal(LEGAL.company)}. We review this policy at least every 12 months.</Text>
+
+      <H>What we collect</H>
+      <Text>• Account: your email and password (the password is handled by Firebase Authentication; we never see it).</Text>
+      <Text>• Age check: your birth month and year, used once at sign-up. We keep only whether you are 13 or older, not your birth date.</Text>
+      <Text>• Text messages: if you opt in, your phone number, when you agreed, and the consent wording you saw; and whether you replied STOP.</Text>
+      <Text>• Content: photos you post and their captions. Posts are public to everyone using the app.</Text>
+      <Text>• Safety: users you block and reports you file.</Text>
+
+      <H>Who we share it with</H>
+      <Text>• Google Firebase (authentication, database, file storage, server functions) stores all of the above.</Text>
+      <Text>• OpenAI receives a short text description when we write a caption for your post. Captions are AI-generated and labelled as such.</Text>
+      <Text>• Twilio receives your phone number and message text if you opted in to texts.</Text>
+      <Text>The app contains no advertising or analytics trackers. We do not sell your personal information or share it for cross-context behavioral advertising.</Text>
+
+      <H>Your choices and rights</H>
+      <Text>• Delete your account, profile, posts, and photos: Settings → Delete my account.</Text>
+      <Text>• Get a copy of your data: Settings → Download my data.</Text>
+      <Text>• Stop marketing texts: reply STOP to any message.</Text>
+      <Text>• Other requests (access, correction): {legal(LEGAL.contactEmail)}.</Text>
+      <Text>Retention: {legal(LEGAL.retention)}</Text>
+
+      <H>California residents</H>
+      <Text>Categories collected: identifiers (email, phone), age bracket, user content (photos, captions), and safety records. Sources: you. Purposes: running the app, sending texts you agreed to, safety and moderation. Recipients: the service providers listed above. You have the right to know, delete, and correct your personal information and to opt out of sale or sharing (we do neither), and we won't discriminate against you for using these rights. Use Settings or email {legal(LEGAL.contactEmail)}.</Text>
+
+      <H>Children</H>
+      <Text>InstaVibe is not directed to children under 13, and we don't knowingly collect their personal information. If you believe a child under 13 has an account, contact us and we'll delete it.</Text>
+
+      <H>Contact</H>
+      <Text>{legal(LEGAL.contactEmail)}</Text>
+    </ScrollView>
+  );
+}
