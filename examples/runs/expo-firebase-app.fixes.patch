 rules_version = '2';
 service cloud.firestore {
   match /databases/{database}/documents {
-    match /{document=**} {
-      allow read, write: if request.time < timestamp.date(2026, 12, 31);
+    // Profiles (email, phone, consent) are written only by Cloud Functions.
+    match /users/{uid} {
+      allow read: if request.auth != null && request.auth.uid == uid;
+
+      match /blocks/{otherUid} {
+        allow read, write: if request.auth != null && request.auth.uid == uid;
+      }
+    }
+
+    match /posts/{postId} {
+      allow read: if true;
+      allow create: if request.auth != null
+        && request.resource.data.uid == request.auth.uid
+        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is13Plus == true
+        && request.resource.data.keys().hasOnly(['uid', 'imageUrl', 'imagePath', 'caption', 'aiCaption', 'createdAt']);
+      allow update: if request.auth != null
+        && resource.data.uid == request.auth.uid
+        && request.resource.data.uid == resource.data.uid;
+      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
+    }
+
+    // Reports: any signed-in user can file one; only admins (server) can read them.
+    match /reports/{reportId} {
+      allow create: if request.auth != null
+        && request.resource.data.reporterUid == request.auth.uid
+        && request.resource.data.keys().hasOnly(['postId', 'postUid', 'reporterUid', 'reason', 'createdAt']);
     }
   }
