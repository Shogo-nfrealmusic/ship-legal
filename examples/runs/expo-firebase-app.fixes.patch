+++ b/app/settings.tsx
@@ -0,0 +1,43 @@
+import { Alert, Share, Text, TouchableOpacity, View } from "react-native";
+import { Link, router } from "expo-router";
+import { signOut } from "firebase/auth";
+import { httpsCallable } from "firebase/functions";
+import { auth, functions } from "@/lib/firebase";
+import { LEGAL, legal } from "@/lib/legal";
+
+export default function Settings() {
+  async function downloadData() {
+    const res = await httpsCallable(functions, "exportMyData")();
+    await Share.share({ message: JSON.stringify(res.data, null, 2) });
+  }
+
+  function deleteAccount() {
+    Alert.alert("Delete your account?", "This deletes your account, profile, posts, and photos. It can't be undone.", [
+      { text: "Cancel", style: "cancel" },
+      {
+        text: "Delete",
+        style: "destructive",
+        onPress: async () => {
+          await httpsCallable(functions, "deleteAccount")();
+          await signOut(auth);
+          router.replace("/");
+        },
+      },
+    ]);
+  }
+
+  return (
+    <View style={{ flex: 1, padding: 24, paddingTop: 60, gap: 16 }}>
+      <Link href="/privacy" accessibilityRole="link">Privacy Policy</Link>
+      <Link href="/terms" accessibilityRole="link">Terms</Link>
+      <Link href="/dmca" accessibilityRole="link">Copyright (DMCA)</Link>
+      <Text>Report abuse or contact us: {legal(LEGAL.contactEmail)}</Text>
+      <TouchableOpacity onPress={downloadData} accessibilityRole="button" accessibilityLabel="Download my data">
+        <Text>Download my data</Text>
+      </TouchableOpacity>
+      <TouchableOpacity onPress={deleteAccount} accessibilityRole="button" accessibilityLabel="Delete my account">
+        <Text style={{ color: "#b91c1c" }}>Delete my account</Text>
+      </TouchableOpacity>
+    </View>
+  );
+}
