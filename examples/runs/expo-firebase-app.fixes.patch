+const STOP_WORDS = ["STOP", "STOPALL", "UNSUBSCRIBE", "CANCEL", "END", "QUIT", "REVOKE", "OPTOUT"];
+
+// Sign-up with a neutral age check. Under 13: no account and nothing stored.
+exports.signUp = onCall(async (req) => {
+  const { email, password, phone, birthMonth, birthYear, smsConsent } = req.data || {};
+  const now = new Date();
+  const month = Number(birthMonth);
+  const year = Number(birthYear);
+  if (!Number.isInteger(month) || month < 1 || month > 12 || !Number.isInteger(year) || year < 1900 || year > now.getFullYear()) {
+    throw new HttpsError("invalid-argument", "Enter a valid birth month and year.");
+  }
+  let age = now.getFullYear() - year;
+  if (now.getMonth() + 1 < month) age -= 1;
+  if (age < 13) return { ok: false };
+
+  const wantsTexts = smsConsent === true;
+  const e164 = String(phone || "").replace(/[\s()-]/g, "");
+  if (wantsTexts && !/^\+[1-9]\d{7,14}$/.test(e164)) {
+    throw new HttpsError("invalid-argument", "Enter your phone number with country code, e.g. +1 555 123 4567.");
+  }
+
+  let user;
+  try {
+    user = await admin.auth().createUser({ email, password });
+  } catch (e) {
+    throw new HttpsError("invalid-argument", e.message);
+  }
+  await admin.firestore().collection("users").doc(user.uid).set({
+    email,
+    is13Plus: true,
+    smsConsent: wantsTexts,
+    ...(wantsTexts ? { phone: e164, smsConsentAt: Date.now(), smsConsentText: SMS_CONSENT_TEXT } : {}),
+    createdAt: Date.now(),
+  });
+  return { ok: true };
+});
+
+// Writes a caption for the photo with GPT. The OpenAI key stays on the server.
+exports.suggestCaption = onCall({ secrets: [openaiKey] }, async (req) => {
+  if (!req.auth) throw new HttpsError("unauthenticated", "Sign in first.");
+  const description = String(req.data?.description || "").slice(0, 200);
+  const res = await fetch("https://api.openai.com/v1/chat/completions", {
+    method: "POST",
+    headers: { "Content-Type": "application/json", Authorization: `Bearer ${openaiKey.value()}` },
+    body: JSON.stringify({ model: "gpt-4o-mini", messages: [{ role: "user", content: `Write a fun caption for: ${description}` }] }),
+  });
+  const data = await res.json();
+  return { caption: data.choices?.[0]?.message?.content ?? "" };
+});
+
+// Deletes the caller's account, profile, posts, photos, and reports.
+exports.deleteAccount = onCall(async (req) => {
+  if (!req.auth) throw new HttpsError("unauthenticated", "Sign in first.");
+  const uid = req.auth.uid;
+  const db = admin.firestore();
+  const posts = await db.collection("posts").where("uid", "==", uid).get();
+  const filed = await db.collection("reports").where("reporterUid", "==", uid).get();
+  const about = await db.collection("reports").where("postUid", "==", uid).get();
+  const writer = db.bulkWriter();
+  for (const d of [...posts.docs, ...filed.docs, ...about.docs]) writer.delete(d.ref);
+  await writer.close();
+  await db.recursiveDelete(db.collection("users").doc(uid));
+  await admin.storage().bucket().deleteFiles({ prefix: `posts/${uid}/` });
+  await admin.auth().deleteUser(uid);
+  return { ok: true };
+});
+
+// Returns the caller's own data as JSON.
+exports.exportMyData = onCall(async (req) => {
+  if (!req.auth) throw new HttpsError("unauthenticated", "Sign in first.");
+  const uid = req.auth.uid;
+  const db = admin.firestore();
+  const profile = await db.collection("users").doc(uid).get();
+  const blocks = await db.collection("users").doc(uid).collection("blocks").get();
+  const posts = await db.collection("posts").where("uid", "==", uid).get();
+  return {
+    profile: profile.data() || null,
+    blockedUsers: blocks.docs.map((d) => d.id),
+    posts: posts.docs.map((d) => ({ id: d.id, ...d.data() })),
+  };
+});
+
+// Twilio inbound webhook: records STOP replies so we stop texting that number.
+exports.smsInbound = onRequest(async (req, res) => {
+  const url = process.env.TWILIO_WEBHOOK_URL;
+  if (!url) {
+    res.status(500).send("TWILIO_WEBHOOK_URL is not set");
+    return;
+  }
+  if (!twilio.validateRequest(process.env.TWILIO_TOKEN, req.get("X-Twilio-Signature") || "", url, req.body || {})) {
+    res.status(403).send("Invalid signature");
+    return;
+  }
+  const word = String(req.body.Body || "").trim().toUpperCase();
+  if (STOP_WORDS.includes(word)) {
+    const users = await admin.firestore().collection("users").where("phone", "==", req.body.From).get();
+    for (const u of users.docs) await u.ref.update({ smsOptOut: true, smsOptOutAt: Date.now() });
+  }
+  res.type("text/xml").send("<Response></Response>");
+});
+
