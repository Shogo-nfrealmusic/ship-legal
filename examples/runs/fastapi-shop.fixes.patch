+def authenticate(request: Request, email: str, password: str):
+    """Checks email + password with per-IP and per-email limits on failures. Returns the user row or None."""
+    buckets = [f"login:ip:{client_ip(request)}", f"login:email:{email.lower()}"]
+    if any(too_many(b) for b in buckets):
+        raise HTTPException(429, "Too many attempts. Try again later.", headers={"Retry-After": str(RATE_WINDOW)})
+    c = conn()
