+# Settings come from environment variables (see .env.example). Never put values here.
+import os
+
+PRODUCTION = os.environ.get("APP_ENV") == "production"
+
+
+def required(name: str) -> str:
+    """Env value that must be set before real users see it; refuses in production when missing."""
+    value = os.environ.get(name, "")
+    if value:
+        return value
+    if PRODUCTION:
+        raise RuntimeError(f"{name} is not set")
+    return f"TODO(legal-check): set {name}"
+
+
+def secret(name: str) -> str:
+    """Secret env value; empty outside production when missing, error in production."""
+    value = os.environ.get(name, "")
+    if not value and PRODUCTION:
+        raise RuntimeError(f"{name} is not set")
+    return value
+
+
+STRIPE_SECRET_KEY = secret("STRIPE_SECRET_KEY")
+MAILGUN_API_KEY = secret("MAILGUN_API_KEY")
+UNSUBSCRIBE_SECRET = secret("UNSUBSCRIBE_SECRET")
+ADMIN_USERNAME = os.environ.get("ADMIN_USERNAME", "")
+ADMIN_PASSWORD = os.environ.get("ADMIN_PASSWORD", "")
+ADMIN_EMAIL = os.environ.get("ADMIN_EMAIL", "")
