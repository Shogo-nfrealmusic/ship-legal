diff --git a/migrations/001_remove_card_data.sql b/migrations/001_remove_card_data.sql
new file mode 100644
index 0000000..8e49775
--- /dev/null
+++ b/migrations/001_remove_card_data.sql
@@ -0,0 +1,9 @@
+-- Existing printpal.db files still have card columns from the old schema.
+-- Card numbers and CVCs must be deleted, never archived or backed up.
+-- Run once against the production database (SQLite 3.35+), then delete old backups that contain them.
+update orders set card_number = null, card_expiry = null, card_cvc = null;
+alter table orders drop column card_number;
+alter table orders drop column card_expiry;
+alter table orders drop column card_cvc;
+alter table orders add column status text default 'pending';
+alter table orders add column stripe_session_id text;
