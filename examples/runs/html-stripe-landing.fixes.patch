+// Consent for analytics (GA4), session replay (Hotjar) and ad pixels (Google Ads, TikTok).
+// Nothing loads until the visitor clicks "Accept". Ad pixels are also skipped when the
+// browser sends Global Privacy Control or the visitor opted out of "sharing".
+(function () {
+  var CONSENT_KEY = "ff-consent"; // "accepted" | "declined"
+  var ADS_OPTOUT_KEY = "ff-ads-optout"; // "1" = Do Not Sell or Share
+  var loaded = false;
+
+  function get(key) { try { return localStorage.getItem(key); } catch (e) { return null; } }
+  function set(key, value) { try { localStorage.setItem(key, value); } catch (e) {} }
+
+  function adsAllowed() {
+    return navigator.globalPrivacyControl !== true && get(ADS_OPTOUT_KEY) !== "1";
+  }
+
+  function loadGtag(withAds) {
+    var s = document.createElement("script");
+    s.async = true;
+    s.src = "https://www.googletagmanager.com/gtag/js?id=G-ABC123XYZ";
+    document.head.appendChild(s);
+    window.dataLayer = window.dataLayer || [];
+    window.gtag = function () { dataLayer.push(arguments); };
+    gtag("js", new Date());
+    gtag("config", "G-ABC123XYZ");
+    if (withAds) gtag("config", "AW-987654321");
+  }
+
+  function loadTikTok() {
+    !function (w, d, t) { w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];ttq.methods=["page","track"];
+    ttq.load=function(e){var s=d.createElement("script");s.async=!0;s.src="https://analytics.tiktok.com/i18n/pixel/events.js?sdkid="+e;d.head.appendChild(s)};
+    ttq.load('CABCDEF123'); ttq.page(); }(window, document, 'ttq');
+  }
+
+  function loadHotjar() {
+    (function(h,o,t,j,a,r){h.hj=h.hj||function(){(h.hj.q=h.hj.q||[]).push(arguments)};
+    h._hjSettings={hjid:3456789,hjsv:6};a=o.getElementsByTagName('head')[0];
+    r=o.createElement('script');r.async=1;r.src=t+h._hjSettings.hjid+j+h._hjSettings.hjsv;a.appendChild(r);
+    })(window,document,'https://static.hotjar.com/c/hotjar-','.js?sv=');
+  }
+
+  function loadTrackers() {
+    if (loaded) return;
+    loaded = true;
+    var ads = adsAllowed();
+    loadGtag(ads);
+    loadHotjar();
+    if (ads) loadTikTok();
+  }
+
+  var banner = document.createElement("div");
+  banner.className = "consent-banner";
+  banner.setAttribute("role", "dialog");
+  banner.setAttribute("aria-label", "Cookie choices");
+  banner.hidden = true;
+  banner.innerHTML =
+    '<p>We use cookies for analytics, session recordings and ads to improve FocusFlow and ' +
+    'measure our marketing. See our <a href="privacy.html">Privacy Policy</a>.</p>' +
+    '<button type="button" class="btn" data-consent="accepted">Accept</button> ' +
+    '<button type="button" class="btn" data-consent="declined">Decline</button>';
+  document.body.appendChild(banner);
+
+  function choose(value) {
+    var previous = get(CONSENT_KEY);
+    set(CONSENT_KEY, value);
+    banner.hidden = true;
+    if (value === "accepted") loadTrackers();
+    // Scripts that already ran can't be unloaded; a reload stops them.
+    else if (previous === "accepted" && loaded) location.reload();
+  }
+
+  document.addEventListener("click", function (e) {
+    var target = e.target.closest("[data-consent], [data-cookie-settings], [data-optout-sharing]");
+    if (!target) return;
+    if (target.hasAttribute("data-consent")) choose(target.getAttribute("data-consent"));
+    else if (target.hasAttribute("data-cookie-settings")) banner.hidden = false;
+    else {
+      set(ADS_OPTOUT_KEY, "1");
+      var status = document.getElementById("optout-status");
+      if (status) status.textContent = "Done. We won't load advertising pixels in this browser.";
+      if (loaded) location.reload();
+    }
+  });
+
+  if (get(CONSENT_KEY) === "accepted") loadTrackers();
+  else if (!get(CONSENT_KEY)) banner.hidden = false;
+})();
diff --git a/netlify/functions/subscribe.js b/netlify/functions/subscribe.js
new file mode 100644
index 0000000..4d37ccc
--- /dev/null
+++ b/netlify/functions/subscribe.js
@@ -0,0 +1,47 @@
+// Newsletter + SMS tips signup. Keeps the Airtable token on the server (env vars below).
+// Public by design (newsletter form): no login, so input is validated and size-limited.
+const SMS_CONSENT_TEXT =
+  "I agree to receive recurring marketing text messages from FocusFlow at this number. " +
+  "Consent is not a condition of purchase. Msg & data rates may apply. Reply STOP to " +
+  "cancel, HELP for help.";
+
+export default async (req) => {
+  if (req.method !== "POST") return new Response("Method not allowed", { status: 405 });
+
+  const token = process.env.AIRTABLE_TOKEN;
+  const baseId = process.env.AIRTABLE_BASE_ID;
+  if (!token || !baseId) return new Response("Server not configured", { status: 500 });
+
+  const raw = await req.text();
+  if (raw.length > 2000) return new Response("Too large", { status: 413 });
+  let body;
+  try { body = JSON.parse(raw); } catch { return new Response("Bad request", { status: 400 }); }
+
+  const email = String(body.email || "").trim();
+  if (email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
+    return new Response("Invalid email", { status: 400 });
+  }
+  const smsConsent = body.smsConsent === true;
+  const phone = smsConsent ? String(body.phone || "").trim() : "";
+  if (smsConsent && !/^\+?[0-9\s().-]{7,20}$/.test(phone)) {
+    return new Response("Invalid phone", { status: 400 });
+  }
+
+  const fields = { Email: email, Source: "landing" };
+  if (smsConsent) {
+    // Record of written consent for marketing texts (TCPA).
+    Object.assign(fields, {
+      Phone: phone,
+      SmsConsentAt: new Date().toISOString(),
+      SmsConsentText: SMS_CONSENT_TEXT,
+    });
+  }
+
+  const res = await fetch(`https://api.airtable.com/v0/${baseId}/Subscribers`, {
+    method: "POST",
+    headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
+    body: JSON.stringify({ fields }),
+  });
+  if (!res.ok) return new Response("Upstream error", { status: 502 });
+  return new Response(null, { status: 204 });
+};
