+// Admin data (all users' emails, content reports). Admins come from the ADMIN_EMAILS secret.
+import { adminClient, corsHeaders, getUser, json } from "../_shared/http.ts";
+
+Deno.serve(async (req) => {
+  if (req.method === "OPTIONS") return new Response("ok", { headers: corsHeaders });
+
+  const user = await getUser(req);
+  if (!user) return json({ error: "Not signed in." }, 401);
+  const admins = (Deno.env.get("ADMIN_EMAILS") ?? "")
+    .split(",")
+    .map((e) => e.trim().toLowerCase())
+    .filter(Boolean);
+  if (!user.email || !user.email_confirmed_at || !admins.includes(user.email.toLowerCase())) {
+    return json({ error: "Not authorized." }, 403);
+  }
+
+  const db = adminClient();
+  const { data: list, error } = await db.auth.admin.listUsers({ perPage: 1000 });
+  if (error) return json({ error: "Could not load users." }, 500);
+  const { data: profiles } = await db.from("profiles").select("id, username");
+  const names = new Map((profiles ?? []).map((p) => [p.id, p.username]));
+  const users = list.users.map((u) => ({ id: u.id, email: u.email ?? "", username: names.get(u.id) ?? "" }));
+  const { data: reports } = await db
+    .from("reports")
+    .select("id, post_id, reason, created_at")
+    .order("created_at", { ascending: false });
+
+  return json({ users, reports: reports ?? [] });
+});
