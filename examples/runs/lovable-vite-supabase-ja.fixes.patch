diff --git a/src/lib/consent.ts b/src/lib/consent.ts
new file mode 100644
index 0000000..91c5f05
--- /dev/null
+++ b/src/lib/consent.ts
@@ -0,0 +1,54 @@
+// Ad trackers (Meta Pixel) load only after "Accept", and never when Global Privacy Control is on.
+export type Consent = "accepted" | "declined";
+
+const KEY = "consent";
+
+export function getConsent(): Consent | null {
+  const v = localStorage.getItem(KEY);
+  return v === "accepted" || v === "declined" ? v : null;
+}
+
+export function gpcEnabled() {
+  return (navigator as Navigator & { globalPrivacyControl?: boolean }).globalPrivacyControl === true;
+}
+
+export function setConsent(choice: Consent) {
+  const previous = getConsent();
+  localStorage.setItem(KEY, choice);
+  if (choice === "accepted") loadTrackers();
+  // A loaded pixel can't be unloaded; reload so it's gone.
+  else if (previous === "accepted") location.reload();
+}
+
+export function loadTrackers() {
+  if (gpcEnabled() || getConsent() !== "accepted") return;
+  loadMetaPixel();
+}
+
+type Fbq = ((...args: unknown[]) => void) & {
+  callMethod?: (...args: unknown[]) => void;
+  queue: unknown[][];
+  push: Fbq;
+  loaded: boolean;
+  version: string;
+};
+
+function loadMetaPixel() {
+  const w = window as unknown as { fbq?: Fbq; _fbq?: Fbq };
+  if (w.fbq) return;
+  const fbq = ((...args: unknown[]) => {
+    if (fbq.callMethod) fbq.callMethod(...args);
+    else fbq.queue.push(args);
+  }) as Fbq;
+  fbq.queue = [];
+  fbq.push = fbq;
+  fbq.loaded = true;
+  fbq.version = "2.0";
+  w.fbq = w._fbq = fbq;
+  const s = document.createElement("script");
+  s.async = true;
+  s.src = "https://connect.facebook.net/en_US/fbevents.js";
+  document.head.appendChild(s);
+  fbq("init", "123456789012345");
+  fbq("track", "PageView");
+}
