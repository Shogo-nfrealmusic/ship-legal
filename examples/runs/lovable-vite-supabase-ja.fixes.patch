+  const [choice, setChoice] = useState(getConsent());
+  const gpc = gpcEnabled();
+
+  return (
+    <main>
+      <h2>Your Privacy Choices</h2>
+      <p>
+        With your consent we use the Meta Pixel to measure our ads. Under California law this can count as
+        "sharing" personal information. You can opt out here at any time. See our{" "}
+        <Link to="/privacy">Privacy Policy</Link>.
+      </p>
+      {gpc ? (
+        <p>Your browser sends a Global Privacy Control signal, so ad tracking is off.</p>
+      ) : (
+        <>
+          <p>Current choice: {choice === "accepted" ? "ad cookies allowed" : "ad cookies off"}</p>
+          <button type="button" onClick={() => { setConsent("declined"); setChoice("declined"); }}>
+            Do Not Sell or Share My Personal Information
+          </button>{" "}
+          <button type="button" onClick={() => { setConsent("accepted"); setChoice("accepted"); }}>
+            Allow ad cookies
+          </button>
+        </>
+      )}
+    </main>
+  );
+}
