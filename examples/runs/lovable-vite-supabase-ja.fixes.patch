--- /dev/null
+++ b/src/pages/Account.tsx
@@ -0,0 +1,48 @@
+import { useState } from "react";
+import { useNavigate } from "react-router-dom";
+import { functionErrorBody, supabase } from "@/lib/supabase";
+
+export default function Account() {
+  const nav = useNavigate();
+  const [status, setStatus] = useState("");
+
+  async function download() {
+    const { data: { user } } = await supabase.auth.getUser();
+    if (!user) return setStatus("Sign in to download your data.");
+    const [profile, posts, blocks] = await Promise.all([
+      supabase.from("profiles").select("*").eq("id", user.id).maybeSingle(),
+      supabase.from("posts").select("*").eq("user_id", user.id),
+      supabase.from("blocks").select("*").eq("blocker_id", user.id),
+    ]);
+    const data = {
+      account: { id: user.id, email: user.email, created_at: user.created_at },
+      profile: profile.data,
+      posts: posts.data ?? [],
+      blocks: blocks.data ?? [],
+    };
+    const url = URL.createObjectURL(new Blob([JSON.stringify(data, null, 2)], { type: "application/json" }));
+    const a = document.createElement("a");
+    a.href = url;
+    a.download = "chatfit-data.json";
+    a.click();
+    URL.revokeObjectURL(url);
+  }
+
+  async function deleteAccount() {
+    if (!confirm("Delete your account, posts and photos permanently? This can't be undone.")) return;
+    const { error } = await supabase.functions.invoke("delete-account");
+    if (error) return setStatus((await functionErrorBody(error)).error ?? "Could not delete the account.");
+    await supabase.auth.signOut();
+    nav("/");
+  }
+
+  return (
+    <main>
+      <h2>Your account</h2>
+      <p>Download a copy of your data, or delete your account and everything you posted.</p>
+      <button type="button" onClick={download}>Download my data</button>{" "}
+      <button type="button" onClick={deleteAccount}>Delete my account</button>
+      {status && <p role="status">{status}</p>}
+    </main>
+  );
+}
