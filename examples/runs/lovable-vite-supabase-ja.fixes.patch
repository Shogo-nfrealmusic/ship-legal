--- /dev/null
+++ b/src/components/ConsentBanner.tsx
@@ -0,0 +1,29 @@
+import { useEffect, useState } from "react";
+import { Link } from "react-router-dom";
+import { type Consent, getConsent, gpcEnabled, loadTrackers, setConsent } from "@/lib/consent";
+
+export default function ConsentBanner() {
+  const [open, setOpen] = useState(false);
+
+  useEffect(() => {
+    loadTrackers();
+    setOpen(getConsent() === null && !gpcEnabled());
+  }, []);
+
+  if (!open) return null;
+
+  function choose(choice: Consent) {
+    setConsent(choice);
+    setOpen(false);
+  }
+
+  return (
+    <div role="dialog" aria-label="Cookie choices" className="consent">
+      <p>
+        We use cookies for ads (Meta Pixel) to measure our marketing. <Link to="/privacy">Privacy Policy</Link>
+      </p>
+      <button type="button" onClick={() => choose("accepted")}>Accept</button>
+      <button type="button" onClick={() => choose("declined")}>Decline</button>
+    </div>
+  );
+}
