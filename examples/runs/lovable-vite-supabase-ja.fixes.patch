+++ b/supabase/functions/delete-account/index.ts
@@ -0,0 +1,24 @@
+// Deletes the caller's account, photos, and (via on delete cascade) profile, posts, reports, blocks.
+import { adminClient, corsHeaders, getUser, json } from "../_shared/http.ts";
+
+Deno.serve(async (req) => {
+  if (req.method === "OPTIONS") return new Response("ok", { headers: corsHeaders });
+
+  const user = await getUser(req);
+  if (!user) return json({ error: "Sign in to delete your account." }, 401);
+
+  const db = adminClient();
+  const paths = new Set<string>();
+  const { data: posts } = await db.from("posts").select("photo_url").eq("user_id", user.id);
+  for (const p of posts ?? []) {
+    const path = p.photo_url?.split("/object/public/photos/")[1];
+    if (path) paths.add(decodeURIComponent(path));
+  }
+  const { data: files } = await db.storage.from("photos").list(user.id, { limit: 1000 });
+  for (const f of files ?? []) paths.add(`${user.id}/${f.name}`);
+  if (paths.size) await db.storage.from("photos").remove([...paths]);
+
+  const { error } = await db.auth.admin.deleteUser(user.id);
+  if (error) return json({ error: "Could not delete the account." }, 500);
+  return json({ ok: true });
+});
diff --git a/supabase/functions/signup/index.ts b/supabase/functions/signup/index.ts
new file mode 100644
index 0000000..dd9cea8
--- /dev/null
+++ b/supabase/functions/signup/index.ts
@@ -0,0 +1,41 @@
+// Sign-up with a neutral age screen (COPPA). Under 13: no account and nothing stored.
+// Only `is_13_plus` is saved, never the birth date.
+import { createClient } from "npm:@supabase/supabase-js@2";
+import { adminClient, corsHeaders, json } from "../_shared/http.ts";
+
+const NEUTRAL = "Sorry, we can't create an account for you right now.";
+
+Deno.serve(async (req) => {
+  if (req.method === "OPTIONS") return new Response("ok", { headers: corsHeaders });
+
+  const { email, password, username, birthMonth, birthYear } = await req.json().catch(() => ({}));
+  const now = new Date();
+  if (
+    typeof email !== "string" || typeof password !== "string" ||
+    typeof username !== "string" || username.trim().length < 1 || username.length > 30 ||
+    !Number.isInteger(birthMonth) || birthMonth < 1 || birthMonth > 12 ||
+    !Number.isInteger(birthYear) || birthYear < 1900 || birthYear > now.getUTCFullYear()
+  ) {
+    return json({ error: "Please fill in every field." }, 400);
+  }
+
+  let age = now.getUTCFullYear() - birthYear;
+  if (now.getUTCMonth() + 1 < birthMonth) age -= 1;
+  if (age < 13) return json({ error: NEUTRAL, blocked: true }, 403);
+
+  const anon = createClient(Deno.env.get("SUPABASE_URL")!, Deno.env.get("SUPABASE_ANON_KEY")!);
+  const { data, error } = await anon.auth.signUp({ email, password });
+  if (error || !data.user) return json({ error: error?.message ?? "Sign-up failed." }, 400);
+  // An existing email comes back with no identities; don't touch that account.
+  if (!data.user.identities?.length) return json({ error: "Could not create the account." }, 400);
+
+  const db = adminClient();
+  const { error: profileError } = await db
+    .from("profiles")
+    .insert({ id: data.user.id, username: username.trim(), is_13_plus: true });
+  if (profileError) {
+    await db.auth.admin.deleteUser(data.user.id);
+    return json({ error: "That username is taken." }, 400);
+  }
+  return json({ ok: true });
+});
