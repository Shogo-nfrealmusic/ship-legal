+-- legal-check: row level security, safer photo uploads, 13+ gate, reports and blocks.
+-- Review, then apply with `supabase db push`.
+
+-- Delete a user's rows when their auth account is deleted.
+alter table public.profiles drop constraint profiles_id_fkey,
+  add constraint profiles_id_fkey foreign key (id) references auth.users(id) on delete cascade;
+alter table public.posts drop constraint posts_user_id_fkey,
+  add constraint posts_user_id_fkey foreign key (user_id) references auth.users(id) on delete cascade;
+
+-- Emails already live in auth.users; don't keep a copy that other users could read.
+alter table public.profiles drop column email;
+
+-- Set to true only by the signup Edge Function after its age check.
+alter table public.profiles add column is_13_plus boolean not null default false;
+
+-- profiles: public usernames; written only by Edge Functions (service role).
+alter table public.profiles enable row level security;
+create policy "Profiles are public" on public.profiles for select using (true);
+
+-- posts: public feed; 13+ users post as themselves and delete their own.
+alter table public.posts alter column user_id set default auth.uid();
+alter table public.posts enable row level security;
+create policy "Posts are public" on public.posts for select using (true);
+create policy "13+ users post as themselves" on public.posts for insert to authenticated
+  with check (
+    auth.uid() = user_id
+    and exists (select 1 from public.profiles p where p.id = auth.uid() and p.is_13_plus)
+  );
+create policy "Users delete their own posts" on public.posts for delete to authenticated
+  using (auth.uid() = user_id);
+
+-- Take the username from the poster's profile instead of trusting the client.
+create function public.set_post_username() returns trigger
+language plpgsql security definer set search_path = public as $$
+begin
+  new.username := (select username from public.profiles where id = new.user_id);
+  return new;
+end $$;
+create trigger posts_set_username before insert on public.posts
+  for each row execute function public.set_post_username();
+
+-- photos bucket stays public (feed photos are public), but only images, 5 MB max,
+-- and each user writes only to their own folder.
+update storage.buckets
+  set file_size_limit = 5242880,
+      allowed_mime_types = array['image/jpeg', 'image/png', 'image/webp', 'image/gif']
+  where id = 'photos';
+create policy "Users upload photos to their own folder" on storage.objects for insert to authenticated
+  with check (bucket_id = 'photos' and (storage.foldername(name))[1] = auth.uid()::text);
+create policy "Users delete their own photos" on storage.objects for delete to authenticated
+  using (bucket_id = 'photos' and (storage.foldername(name))[1] = auth.uid()::text);
+
+-- reports: anyone signed in can file one; only the admin Edge Function (service role) reads them.
+create table public.reports (
+  id uuid primary key default gen_random_uuid(),
+  reporter_id uuid not null default auth.uid() references auth.users(id) on delete cascade,
+  post_id uuid not null references public.posts(id) on delete cascade,
+  reason text not null check (char_length(reason) between 1 and 500),
+  created_at timestamptz default now()
+);
+alter table public.reports enable row level security;
+create policy "Users file reports as themselves" on public.reports for insert to authenticated
+  with check (auth.uid() = reporter_id);
+
+-- blocks: each user manages only their own block list.
+create table public.blocks (
+  blocker_id uuid not null default auth.uid() references auth.users(id) on delete cascade,
+  blocked_id uuid not null references auth.users(id) on delete cascade,
+  created_at timestamptz default now(),
+  primary key (blocker_id, blocked_id)
+);
+alter table public.blocks enable row level security;
+create policy "Users see their own blocks" on public.blocks for select to authenticated
+  using (auth.uid() = blocker_id);
+create policy "Users add their own blocks" on public.blocks for insert to authenticated
+  with check (auth.uid() = blocker_id);
+create policy "Users remove their own blocks" on public.blocks for delete to authenticated
+  using (auth.uid() = blocker_id);
