@@ -0,0 +1,21 @@
+// Admin-only list of users. Admins are the emails in the ADMIN_EMAILS secret (comma-separated).
+import { admin, corsHeaders, getCaller, json } from "../_shared/supabase.ts";
+
+const ADMIN_EMAILS = (Deno.env.get("ADMIN_EMAILS") ?? "")
+  .split(",")
+  .map((s) => s.trim().toLowerCase())
+  .filter(Boolean);
+
+Deno.serve(async (req) => {
+  if (req.method === "OPTIONS") return new Response("ok", { headers: corsHeaders });
+
+  const user = await getCaller(req);
+  if (!user) return json({ error: "Not signed in" }, 401);
+  if (!user.email || !ADMIN_EMAILS.includes(user.email.toLowerCase())) {
+    return json({ error: "Not authorized" }, 403);
+  }
+
+  const { data, error } = await admin.from("profiles").select("id, username, email");
+  if (error) return json({ error: error.message }, 500);
+  return json({ users: data });
+});
