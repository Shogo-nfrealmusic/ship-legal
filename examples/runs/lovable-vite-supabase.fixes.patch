+++ b/src/components/ConsentBanner.tsx
@@ -0,0 +1,33 @@
+import { useEffect, useState } from "react";
+import { Link } from "react-router-dom";
+import { getConsent, loadTrackers, setConsent, type Consent } from "@/lib/consent";
+
+export default function ConsentBanner() {
+  const [open, setOpen] = useState(false);
+
+  useEffect(() => {
+    if (getConsent() === null) setOpen(true);
+    else loadTrackers();
+    const onOpen = () => setOpen(true);
+    window.addEventListener("consent:open", onOpen);
+    return () => window.removeEventListener("consent:open", onOpen);
+  }, []);
+
+  if (!open) return null;
+
+  function choose(c: Consent) {
+    setConsent(c);
+    setOpen(false);
+  }
+
+  return (
+    <div role="dialog" aria-label="Cookie consent" className="consent">
+      <p>
+        We use cookies for ads (Meta Pixel) to measure our marketing.{" "}
+        <Link to="/privacy">Privacy Policy</Link>
+      </p>
+      <button type="button" onClick={() => choose("yes")}>Accept</button>{" "}
+      <button type="button" onClick={() => choose("no")}>Decline</button>
+    </div>
+  );
+}
