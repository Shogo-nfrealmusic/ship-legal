@@ -0,0 +1,28 @@
+// Deletes the caller's photos and auth user. Profile, posts, blocks and reports they filed
+// go with it through `on delete cascade` (see the legal-check migration).
+import { admin, corsHeaders, getCaller, json } from "../_shared/supabase.ts";
+
+Deno.serve(async (req) => {
+  if (req.method === "OPTIONS") return new Response("ok", { headers: corsHeaders });
+
+  const user = await getCaller(req);
+  if (!user) return json({ error: "Not signed in" }, 401);
+
+  const paths = new Set<string>();
+  const { data: files } = await admin.storage.from("photos").list(user.id, { limit: 1000 });
+  for (const f of files ?? []) paths.add(`${user.id}/${f.name}`);
+  // Photos uploaded before per-user folders existed are found through the user's posts.
+  const { data: posts } = await admin.from("posts").select("photo_url").eq("user_id", user.id);
+  for (const p of posts ?? []) {
+    const path = p.photo_url?.split("/object/public/photos/")[1];
+    if (path) paths.add(decodeURIComponent(path));
+  }
+  if (paths.size > 0) {
+    const { error } = await admin.storage.from("photos").remove([...paths]);
+    if (error) return json({ error: error.message }, 500);
+  }
+
+  const { error } = await admin.auth.admin.deleteUser(user.id);
+  if (error) return json({ error: error.message }, 500);
+  return json({ deleted: true });
+});
diff --git a/supabase/functions/signup/index.ts b/supabase/functions/signup/index.ts
new file mode 100644
index 0000000..797fb45
--- /dev/null
+++ b/supabase/functions/signup/index.ts
@@ -0,0 +1,38 @@
+// Sign-up with a neutral age screen (COPPA). Under 13: nothing is created or stored.
+// Only `is_13_plus` is saved, never the birth date.
+import { createClient } from "npm:@supabase/supabase-js@2";
+import { admin, corsHeaders, json } from "../_shared/supabase.ts";
+
+Deno.serve(async (req) => {
+  if (req.method === "OPTIONS") return new Response("ok", { headers: corsHeaders });
+
+  const { email, password, username, birthMonth, birthYear } = await req.json().catch(() => ({}));
+  const now = new Date();
+  if (
+    typeof email !== "string" || typeof password !== "string" ||
+    typeof username !== "string" || username.trim().length < 1 || username.length > 30 ||
+    !Number.isInteger(birthMonth) || birthMonth < 1 || birthMonth > 12 ||
+    !Number.isInteger(birthYear) || birthYear < 1900 || birthYear > now.getUTCFullYear()
+  ) {
+    return json({ error: "Please fill in every field." }, 400);
+  }
+
+  let age = now.getUTCFullYear() - birthYear;
+  if (now.getUTCMonth() + 1 < birthMonth) age -= 1;
+  if (age < 13) return json({ blocked: true });
+
+  const anon = createClient(Deno.env.get("SUPABASE_URL")!, Deno.env.get("SUPABASE_ANON_KEY")!);
+  const { data, error } = await anon.auth.signUp({ email, password });
+  if (error || !data.user) return json({ error: error?.message ?? "Sign-up failed" }, 400);
+  // Supabase returns a user with no identities when the email is already registered.
+  if (data.user.identities?.length === 0) return json({ error: "Could not create this account." }, 400);
+
+  const { error: profileError } = await admin
+    .from("profiles")
+    .insert({ id: data.user.id, username: username.trim(), email, is_13_plus: true });
+  if (profileError) {
+    await admin.auth.admin.deleteUser(data.user.id);
+    return json({ error: "That username is taken." }, 400);
+  }
+  return json({ session: data.session });
+});
diff --git a/supabase/migrations/20260928000000_legal_check_rls.sql b/supabase/migrations/20260928000000_legal_check_rls.sql
new file mode 100644
index 0000000..1ed693d
--- /dev/null
+++ b/supabase/migrations/20260928000000_legal_check_rls.sql
@@ -0,0 +1,70 @@
+-- legal-check: Row Level Security, age gate, report/block. Review, then `supabase db push`.
+
+-- profiles: private (holds emails). Users read only their own row. Rows are created by the
+-- `signup` Edge Function (service role) after the age check, so there is no insert policy.
+alter table public.profiles add column is_13_plus boolean not null default false;
+alter table public.profiles drop constraint profiles_id_fkey,
+  add constraint profiles_id_fkey foreign key (id) references auth.users(id) on delete cascade;
+alter table public.profiles enable row level security;
+create policy "profiles: read own" on public.profiles
+  for select to authenticated using (auth.uid() = id);
+
+-- posts: public feed. Only signed-in users who passed the age screen post, as themselves.
+alter table public.posts alter column user_id set default auth.uid();
+alter table public.posts drop constraint posts_user_id_fkey,
+  add constraint posts_user_id_fkey foreign key (user_id) references auth.users(id) on delete cascade;
+alter table public.posts enable row level security;
+create policy "posts: public read" on public.posts for select using (true);
+create policy "posts: insert own if 13+" on public.posts for insert to authenticated
+  with check (
+    auth.uid() = user_id
+    and exists (select 1 from public.profiles p where p.id = auth.uid() and p.is_13_plus)
+  );
+create policy "posts: delete own" on public.posts for delete to authenticated
+  using (auth.uid() = user_id);
+
+-- The username shown on a post comes from the author's profile, not from the client.
+create function public.set_post_username() returns trigger
+language plpgsql security definer set search_path = public as $$
+begin
+  new.username := (select username from public.profiles where id = new.user_id);
+  return new;
+end $$;
+create trigger posts_set_username before insert on public.posts
+  for each row execute function public.set_post_username();
+
+-- photos bucket stays public (feed images are public by design). Uploads and deletes only
+-- by signed-in users, inside their own folder `<user id>/...`.
+create policy "photos: upload own folder" on storage.objects for insert to authenticated
+  with check (bucket_id = 'photos' and (storage.foldername(name))[1] = auth.uid()::text);
+create policy "photos: delete own" on storage.objects for delete to authenticated
+  using (bucket_id = 'photos' and (storage.foldername(name))[1] = auth.uid()::text);
+
+-- reports: anyone signed in can file one; no select policy, so only admins
+-- (dashboard / service role) can read them.
+create table public.reports (
+  id uuid primary key default gen_random_uuid(),
+  reporter_id uuid not null default auth.uid() references auth.users(id) on delete cascade,
+  post_id uuid references public.posts(id) on delete set null,
+  reported_user_id uuid references auth.users(id) on delete set null,
+  reason text not null check (char_length(reason) between 1 and 500),
+  created_at timestamptz default now()
+);
+alter table public.reports enable row level security;
+create policy "reports: insert own" on public.reports for insert to authenticated
+  with check (auth.uid() = reporter_id);
+
+-- blocks: each user manages only their own block list.
+create table public.blocks (
+  blocker_id uuid not null default auth.uid() references auth.users(id) on delete cascade,
+  blocked_id uuid not null references auth.users(id) on delete cascade,
+  created_at timestamptz default now(),
+  primary key (blocker_id, blocked_id)
+);
+alter table public.blocks enable row level security;
+create policy "blocks: read own" on public.blocks for select to authenticated
