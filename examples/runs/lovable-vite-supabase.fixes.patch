--- /dev/null
+++ b/src/pages/Account.tsx
@@ -0,0 +1,44 @@
+import { useState } from "react";
+import { useNavigate } from "react-router-dom";
+import { supabase } from "@/lib/supabase";
+
+export default function Account() {
+  const nav = useNavigate();
+  const [message, setMessage] = useState("");
+
+  async function download() {
+    const { data: { user } } = await supabase.auth.getUser();
+    if (!user) return setMessage("Sign in to download your data.");
+    const [profile, posts, blocks] = await Promise.all([
+      supabase.from("profiles").select("*").eq("id", user.id).maybeSingle(),
+      supabase.from("posts").select("*").eq("user_id", user.id),
+      supabase.from("blocks").select("*"),
+    ]);
+    const json = JSON.stringify(
+      { account: { id: user.id, email: user.email, created_at: user.created_at }, profile: profile.data, posts: posts.data, blocks: blocks.data },
+      null,
+      2,
+    );
+    const a = document.createElement("a");
+    a.href = URL.createObjectURL(new Blob([json], { type: "application/json" }));
+    a.download = "chatfit-data.json";
+    a.click();
+  }
+
+  async function deleteAccount() {
+    if (!window.confirm("Delete your account, posts and photos permanently? This can't be undone.")) return;
+    const { error } = await supabase.functions.invoke("delete-account");
+    if (error) return setMessage("Could not delete your account. Are you signed in?");
+    await supabase.auth.signOut();
+    nav("/");
+  }
+
+  return (
+    <main>
+      <h2>Your account</h2>
+      <button type="button" onClick={download}>Download my data</button>{" "}
+      <button type="button" onClick={deleteAccount}>Delete my account</button>
+      {message && <p role="alert">{message}</p>}
+    </main>
+  );
+}
