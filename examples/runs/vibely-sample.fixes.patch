+++ b/app/api/account/export/route.ts
@@ -0,0 +1,16 @@
+import { NextResponse } from "next/server";
+import { currentUserId, db } from "@/lib/db";
+
+// GET /api/account/export — the signed-in user's own data as a JSON download.
+export async function GET() {
+  const user = db.findById(currentUserId());
+  if (!user) return NextResponse.json({ error: "Not found" }, { status: 404 });
+
+  const { passwordHash: _passwordHash, ...data } = user;
+  return new NextResponse(JSON.stringify(data, null, 2), {
+    headers: {
+      "Content-Type": "application/json",
+      "Content-Disposition": 'attachment; filename="vibely-data.json"',
+    },
+  });
+}
