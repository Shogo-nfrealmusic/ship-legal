+// Real-world details the legal pages and emails need (address, contacts, DMCA agent).
+// Never ship the placeholder: a missing value throws in production.
+export function legalDetail(name: string): string {
+  const value = process.env[name];
+  if (value) return value;
+  if (process.env.NODE_ENV === "production") {
+    throw new Error(`${name} is not set (see .env.example)`);
+  }
+  return `TODO(legal-check): set ${name}`;
+}
+
+export function appBaseUrl(): string {
+  const url = process.env.NEXT_PUBLIC_APP_URL;
+  if (url) return url;
+  if (process.env.NODE_ENV === "production") {
+    throw new Error("NEXT_PUBLIC_APP_URL is not set");
+  }
+  return "http://localhost:3000";
+}
