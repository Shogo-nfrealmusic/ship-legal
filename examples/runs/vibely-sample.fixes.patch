 }
diff --git a/app/api/unsubscribe/route.ts b/app/api/unsubscribe/route.ts
new file mode 100644
index 0000000..e891b11
--- /dev/null
+++ b/app/api/unsubscribe/route.ts
@@ -0,0 +1,25 @@
+import { NextResponse } from "next/server";
+import { db } from "@/lib/db";
+import { verifyUnsubscribeToken } from "@/lib/unsubscribe";
+
+// POST only: mail scanners open GET links, so the page at /unsubscribe asks for a click.
+// Handles both the confirm form and one-click unsubscribe (RFC 8058, params in the URL).
+export async function POST(req: Request) {
+  const url = new URL(req.url);
+  let email = url.searchParams.get("email");
+  let token = url.searchParams.get("token");
+  const fromForm = !email || !token;
+  if (fromForm) {
+    const form = await req.formData().catch(() => null);
+    email = form?.get("email")?.toString() ?? null;
+    token = form?.get("token")?.toString() ?? null;
+  }
+
+  if (!email || !token || !verifyUnsubscribeToken(email, token)) {
+    return NextResponse.json({ error: "Invalid unsubscribe link" }, { status: 400 });
+  }
+  db.unsubscribe(email);
+
+  if (fromForm) return NextResponse.redirect(new URL("/unsubscribe?done=1", req.url), 303);
+  return NextResponse.json({ unsubscribed: true });
+}
