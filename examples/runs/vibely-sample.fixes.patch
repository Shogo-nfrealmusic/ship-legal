diff --git a/app/consent-banner.tsx b/app/consent-banner.tsx
new file mode 100644
index 0000000..996b615
--- /dev/null
+++ b/app/consent-banner.tsx
@@ -0,0 +1,30 @@
+"use client";
+
+import Link from "next/link";
+import { useEffect, useState } from "react";
+import { CONSENT_EVENT, readConsent, saveConsent, type Consent } from "@/lib/consent";
+
+export function ConsentBanner() {
+  // "unread" until the saved choice is read in the browser, so nothing flashes during SSR.
+  const [choice, setChoice] = useState<Consent | null | "unread">("unread");
+
+  useEffect(() => {
+    const sync = () => setChoice(readConsent());
+    sync();
+    window.addEventListener(CONSENT_EVENT, sync);
+    return () => window.removeEventListener(CONSENT_EVENT, sync);
+  }, []);
+
+  if (choice !== null) return null;
+
+  return (
+    <div className="consent" role="dialog" aria-label="Cookie consent">
+      <p>
+        We use cookies for analytics and session recordings (typed text is masked) to improve
+        Vibely. Nothing is recorded unless you accept. <Link href="/privacy">Privacy Policy</Link>
+      </p>
+      <button onClick={() => saveConsent("yes")}>Accept</button>{" "}
+      <button onClick={() => saveConsent("no")}>Decline</button>
+    </div>
+  );
+}
