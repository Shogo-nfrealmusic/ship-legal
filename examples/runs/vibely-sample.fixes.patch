diff --git a/lib/consent.ts b/lib/consent.ts
new file mode 100644
index 0000000..9df6045
--- /dev/null
+++ b/lib/consent.ts
@@ -0,0 +1,25 @@
+// Visitor's choice about analytics cookies and session recording. Browser only.
+export type Consent = "yes" | "no";
+
+const KEY = "vibely-consent";
+export const CONSENT_EVENT = "vibely-consent-change";
+
+export function readConsent(): Consent | null {
+  try {
+    const v = localStorage.getItem(KEY);
+    return v === "yes" || v === "no" ? v : null;
+  } catch {
+    return null;
+  }
+}
+
+export function saveConsent(choice: Consent) {
+  localStorage.setItem(KEY, choice);
+  window.dispatchEvent(new Event(CONSENT_EVENT));
+}
+
+// "Cookie settings" link: forget the choice so the banner asks again.
+export function reopenConsent() {
+  localStorage.removeItem(KEY);
+  window.dispatchEvent(new Event(CONSENT_EVENT));
+}
