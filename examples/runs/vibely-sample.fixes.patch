+const AGE_BLOCK_COOKIE = "vibely_age_block";
+const NOT_NOW = "Sorry, we can't create an account for you right now.";
+
+function tooMany(retryAfterSeconds: number) {
+  return NextResponse.json(
+    { error: "Too many attempts. Please try again later." },
+    { status: 429, headers: { "Retry-After": String(retryAfterSeconds) } },
+  );
+}
+
+function ageFrom(birthYear: number, birthMonth: number): number {
+  const now = new Date();
+  let age = now.getFullYear() - birthYear;
+  if (now.getMonth() + 1 < birthMonth) age -= 1;
+  return age;
+}
+
+export async function POST(req: NextRequest) {
+  const ipLimit = rateLimit(`signup:ip:${clientIp(req)}`);
+  if (!ipLimit.ok) return tooMany(ipLimit.retryAfterSeconds);
+
+  if (req.cookies.get(AGE_BLOCK_COOKIE)) {
+    return NextResponse.json({ error: NOT_NOW }, { status: 403 });
+  }
+
+  const { name, handle, email, password, birthMonth, birthYear } = await req.json();
