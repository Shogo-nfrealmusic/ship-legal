   }
+  const month = Number(birthMonth);
+  const year = Number(birthYear);
+  if (!Number.isInteger(month) || month < 1 || month > 12 ||
+      !Number.isInteger(year) || year < 1900 || year > new Date().getFullYear()) {
+    return NextResponse.json({ error: "Please enter your date of birth." }, { status: 400 });
+  }
+
+  const emailLimit = rateLimit(`signup:email:${String(email).toLowerCase()}`);
+  if (!emailLimit.ok) return tooMany(emailLimit.retryAfterSeconds);
+
+  // Under 13: create nothing and store nothing (not even the email).
+  if (ageFrom(year, month) < 13) {
+    const res = NextResponse.json({ error: NOT_NOW }, { status: 403 });
+    res.cookies.set(AGE_BLOCK_COOKIE, "1", { maxAge: 60 * 60 * 24, httpOnly: true, sameSite: "lax" });
+    return res;
+  }
+
   const user = db.createUser({
