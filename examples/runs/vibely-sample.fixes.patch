+++ b/app/api/account/route.ts
@@ -0,0 +1,14 @@
+import { NextResponse } from "next/server";
+import { del } from "@vercel/blob";
+import { currentUserId, db } from "@/lib/db";
+
+// DELETE /api/account — deletes the signed-in user, their profile picture and blocks.
+export async function DELETE() {
+  const id = currentUserId();
+  const user = db.findById(id);
+  if (!user) return NextResponse.json({ error: "Not found" }, { status: 404 });
+
+  if (user.avatarUrl) await del(user.avatarUrl);
+  db.deleteUser(id);
+  return NextResponse.json({ deleted: true });
+}
diff --git a/app/api/billing/portal/route.ts b/app/api/billing/portal/route.ts
